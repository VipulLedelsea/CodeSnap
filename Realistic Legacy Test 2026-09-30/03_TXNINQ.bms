         TITLE 'PROPERTY TAX ACCOUNT INQUIRY MAP'
TXNSET   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,               X
               TIOAPFX=YES,STORAGE=AUTO,CTRL=(FREEKB,FRSET),       X
               MAPATTS=(COLOR,HILIGHT),DSATTS=(COLOR,HILIGHT)
TXNINQ   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=38,ATTRB=(ASKIP,BRT),             X
               INITIAL='COUNTY REVENUE - TAX ACCOUNT INQUIRY'
         DFHMDF POS=(1,68),LENGTH=8,ATTRB=(ASKIP,NORM),            X
               INITIAL='TXNINQ01'
         DFHMDF POS=(3,2),LENGTH=14,ATTRB=(ASKIP,NORM),            X
               INITIAL='PARCEL NUMBER:'
PARCEL   DFHMDF POS=(3,18),LENGTH=12,ATTRB=(UNPROT,IC,FSET),       X
               COLOR=TURQUOISE
         DFHMDF POS=(3,34),LENGTH=4,ATTRB=(ASKIP,NORM),            X
               INITIAL='YEAR'
TAXYR    DFHMDF POS=(3,40),LENGTH=4,ATTRB=(UNPROT,FSET),          X
               PICIN='9(4)',COLOR=TURQUOISE
         DFHMDF POS=(5,2),LENGTH=13,ATTRB=(ASKIP,NORM),            X
               INITIAL='OWNER NAME:'
OWNER    DFHMDF POS=(5,18),LENGTH=32,ATTRB=(ASKIP,BRT),            X
               COLOR=GREEN
         DFHMDF POS=(6,2),LENGTH=13,ATTRB=(ASKIP,NORM),            X
               INITIAL='MAIL ADDRESS:'
ADDR1    DFHMDF POS=(6,18),LENGTH=32,ATTRB=(ASKIP,NORM)
ADDR2    DFHMDF POS=(7,18),LENGTH=32,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(9,2),LENGTH=15,ATTRB=(ASKIP,NORM),            X
               INITIAL='ACCOUNT STATUS:'
STATUS   DFHMDF POS=(9,18),LENGTH=10,ATTRB=(ASKIP,BRT),            X
               COLOR=YELLOW
         DFHMDF POS=(10,2),LENGTH=15,ATTRB=(ASKIP,NORM),           X
               INITIAL='ASSESSED VALUE:'
ASSVAL   DFHMDF POS=(10,18),LENGTH=14,ATTRB=(ASKIP,NORM),          X
               PICOUT='$,$$$,$$$,$$9'
         DFHMDF POS=(11,2),LENGTH=15,ATTRB=(ASKIP,NORM),           X
               INITIAL='ANNUAL TAX:'
TAXDUE   DFHMDF POS=(11,18),LENGTH=14,ATTRB=(ASKIP,NORM),          X
               PICOUT='$,$$$,$$$,$$9'
         DFHMDF POS=(12,2),LENGTH=15,ATTRB=(ASKIP,NORM),           X
               INITIAL='PAID TO DATE:'
PAID     DFHMDF POS=(12,18),LENGTH=14,ATTRB=(ASKIP,NORM),          X
               PICOUT='$,$$$,$$$,$$9'
         DFHMDF POS=(13,2),LENGTH=15,ATTRB=(ASKIP,NORM),           X
               INITIAL='BALANCE:'
BALANCE  DFHMDF POS=(13,18),LENGTH=14,ATTRB=(ASKIP,BRT),           X
               PICOUT='$,$$$,$$$,$$9',COLOR=YELLOW
         DFHMDF POS=(15,2),LENGTH=18,ATTRB=(ASKIP,NORM),           X
               INITIAL='LAST PAYMENT DATE:'
LASTPAY  DFHMDF POS=(15,22),LENGTH=10,ATTRB=(ASKIP,NORM),          X
               PICOUT='99/99/9999'
         DFHMDF POS=(15,38),LENGTH=15,ATTRB=(ASKIP,NORM),          X
               INITIAL='LAST RECEIPT:'
RECEIPT  DFHMDF POS=(15,55),LENGTH=16,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(17,2),LENGTH=16,ATTRB=(ASKIP,NORM),           X
               INITIAL='PAYMENT AMOUNT:'
PAYAMT   DFHMDF POS=(17,20),LENGTH=12,ATTRB=(UNPROT,FSET),         X
               PICIN='9(9)V99',COLOR=TURQUOISE
         DFHMDF POS=(17,38),LENGTH=12,ATTRB=(ASKIP,NORM),          X
               INITIAL='TENDER TYPE:'
TENDER   DFHMDF POS=(17,52),LENGTH=1,ATTRB=(UNPROT,FSET),          X
               COLOR=TURQUOISE
         DFHMDF POS=(18,2),LENGTH=15,ATTRB=(ASKIP,NORM),           X
               INITIAL='RECEIPT NUMBER:'
NEWRCPT  DFHMDF POS=(18,20),LENGTH=16,ATTRB=(UNPROT,FSET),         X
               COLOR=TURQUOISE
         DFHMDF POS=(20,2),LENGTH=7,ATTRB=(ASKIP,NORM),            X
               INITIAL='MESSAGE'
MESSAGE  DFHMDF POS=(20,10),LENGTH=68,ATTRB=(ASKIP,BRT),           X
               COLOR=RED
         DFHMDF POS=(22,2),LENGTH=37,ATTRB=(ASKIP,NORM),           X
               INITIAL='ENTER=INQUIRE  PF5=POST  PF7=PREV'
         DFHMDF POS=(23,2),LENGTH=36,ATTRB=(ASKIP,NORM),           X
               INITIAL='PF8=NEXT  PF10=HISTORY  PF12=CANCEL'
         DFHMDF POS=(24,2),LENGTH=15,ATTRB=(ASKIP,NORM),           X
               INITIAL='OPERATOR ID:'
OPERID   DFHMDF POS=(24,19),LENGTH=8,ATTRB=(ASKIP,NORM)
******************************************************************
* COPYBOOK FIELD NOTES FOR THE CICS APPLICATION PROGRAM          *
******************************************************************
* PARCEL  REQUIRED; NORMALIZED TO 12 CHARACTERS BEFORE DB2 READ. *
* TAXYR   DEFAULTS TO CURRENT TAX YEAR FROM CONTROL TABLE.       *
* PAYAMT  MAY NOT EXCEED BALANCE WITHOUT SUPERVISOR OVERRIDE.    *
* TENDER  A=ACH, C=CHECK, W=WIRE. CASH IS NOT ACCEPTED ONLINE.   *
* NEWRCPT GENERATED BY BANK CHANNEL; REQUIRED FOR IDEMPOTENCY.   *
* MESSAGE CLEARED ON EACH RECEIVE; ERROR TEXT COMES FROM MSGTAB. *
* PF5 IS PROTECTED WHEN ACCOUNT STATUS IS NOT ACTIVE.            *
* HISTORY ROUTES TO TRANSACTION TXNH AND MAP TXNHST.             *
* ACCOUNT UPDATE IS PERFORMED BY LINK TO PROGRAM TXNPOST.        *
* AUDIT EVENT INCLUDES OPERATOR ID AND CICS TERMINAL ID.         *
******************************************************************
* RESPONSE CODES                                                  *
******************************************************************
* 0000 SUCCESS                                                    *
* 1001 PARCEL NOT FOUND                                           *
* 1002 TAX YEAR CLOSED                                            *
* 1003 ACCOUNT INACTIVE                                           *
* 2001 PAYMENT EXCEEDS BALANCE                                    *
* 2002 DUPLICATE RECEIPT                                          *
* 3001 DB2 UNAVAILABLE                                            *
* 9001 UNEXPECTED APPLICATION ERROR                               *
******************************************************************
* CHANGE HISTORY                                                  *
* 2018-04-12 RVS INITIAL MAP FOR CICS TS MIGRATION.               *
* 2021-11-07 JLK ADDED WIRE TENDER AND RECEIPT FIELD.             *
* 2024-02-19 MPN ADDED OPERATOR DISPLAY FOR AUDIT REVIEW.         *
******************************************************************
         DFHMSD TYPE=FINAL
         END
