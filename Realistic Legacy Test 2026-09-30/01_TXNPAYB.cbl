000100 IDENTIFICATION DIVISION.
000200 PROGRAM-ID. TXNPAYB.
000400* NIGHTLY PROPERTY-TAX PAYMENT INTAKE.
000500 ENVIRONMENT DIVISION.
000600 CONFIGURATION SECTION.
000700 SOURCE-COMPUTER. IBM-Z15.
000800 OBJECT-COMPUTER. IBM-Z15.
000900 INPUT-OUTPUT SECTION.
001000 FILE-CONTROL.
001100     SELECT BANK-FILE ASSIGN TO BANKIN
001200         ORGANIZATION IS SEQUENTIAL
001300         FILE STATUS IS WS-BANK-STATUS.
001400     SELECT POST-FILE ASSIGN TO POSTOUT
001500         ORGANIZATION IS SEQUENTIAL
001600         FILE STATUS IS WS-POST-STATUS.
001700     SELECT REJECT-FILE ASSIGN TO REJOUT
001800         ORGANIZATION IS SEQUENTIAL.
001900 DATA DIVISION.
002000 FILE SECTION.
002100 FD  BANK-FILE RECORDING MODE IS F.
002200 01  BANK-PAYMENT-RECORD.
002300     05  BK-PARCEL-NUMBER       PIC X(12).
002400     05  BK-RECEIPT-NUMBER      PIC X(16).
002500     05  BK-PAYMENT-DATE        PIC 9(8).
002600     05  BK-AMOUNT              PIC S9(9)V99 COMP-3.
002700     05  BK-TENDER-CODE         PIC X.
002800     05  BK-BANK-ROUTING        PIC X(9).
002900     05  BK-FILLER              PIC X(24).
003000 FD  POST-FILE RECORDING MODE IS F.
003100 01  POSTING-RECORD.
003200     05  PO-PARCEL-NUMBER       PIC X(12).
003300     05  PO-RECEIPT-NUMBER      PIC X(16).
003400     05  PO-PAYMENT-DATE        PIC 9(8).
003500     05  PO-AMOUNT              PIC S9(9)V99 COMP-3.
003600     05  PO-TENDER-CODE         PIC X.
003700     05  PO-SOURCE-SYSTEM       PIC X(4).
003800 FD  REJECT-FILE RECORDING MODE IS F.
003900 01  REJECT-RECORD.
004000     05  RJ-BANK-RECORD         PIC X(74).
004100     05  RJ-REASON-CODE         PIC X(4).
004200 WORKING-STORAGE SECTION.
004300 01  WS-FILE-STATUS.
004400     05  WS-BANK-STATUS         PIC XX VALUE '00'.
004500     05  WS-POST-STATUS         PIC XX VALUE '00'.
004600 01  WS-SWITCHES.
004700     05  WS-END-OF-BANK         PIC X VALUE 'N'.
004800         88  END-OF-BANK         VALUE 'Y'.
004900 01  WS-COUNTERS.
005000     05  WS-READ-COUNT          PIC 9(9) COMP VALUE ZERO.
005100     05  WS-POST-COUNT          PIC 9(9) COMP VALUE ZERO.
005200     05  WS-REJECT-COUNT        PIC 9(9) COMP VALUE ZERO.
005300 01  WS-CONTROL-DATE            PIC 9(8).
005400 01  WS-ERROR-CODE              PIC X(4).
005500 PROCEDURE DIVISION.
005600 0000-MAIN.
005700     PERFORM 1000-INITIALIZE
005800     PERFORM 2000-PROCESS-PAYMENTS UNTIL END-OF-BANK
005900     PERFORM 9000-FINALIZE
006000     GOBACK.
006100 1000-INITIALIZE.
006200     ACCEPT WS-CONTROL-DATE FROM DATE YYYYMMDD
006300     OPEN INPUT BANK-FILE
006400          OUTPUT POST-FILE REJECT-FILE
006500     IF WS-BANK-STATUS NOT = '00'
006600         DISPLAY 'TXNPAYB BANKIN OPEN ERROR ' WS-BANK-STATUS
006700         MOVE 12 TO RETURN-CODE
006800         GOBACK
006900     END-IF
007000     PERFORM 8100-READ-BANK.
007100 2000-PROCESS-PAYMENTS.
007200     MOVE SPACES TO WS-ERROR-CODE
007300     PERFORM 2100-VALIDATE-PAYMENT
007400     IF WS-ERROR-CODE = SPACES
007500         PERFORM 2200-WRITE-POSTING
007600     ELSE
007700         PERFORM 2300-WRITE-REJECT
007800     END-IF
007900     PERFORM 8100-READ-BANK.
008000 2100-VALIDATE-PAYMENT.
008100     IF BK-PARCEL-NUMBER = SPACES
008200         MOVE 'P001' TO WS-ERROR-CODE
008300     ELSE IF BK-RECEIPT-NUMBER = SPACES
008400         MOVE 'R001' TO WS-ERROR-CODE
008500     ELSE IF BK-AMOUNT NOT > ZERO
008600         MOVE 'A001' TO WS-ERROR-CODE
008700     ELSE IF BK-PAYMENT-DATE > WS-CONTROL-DATE
008800         MOVE 'D001' TO WS-ERROR-CODE
008900     ELSE IF BK-TENDER-CODE NOT = 'A' AND 'C' AND 'W'
009000         MOVE 'T001' TO WS-ERROR-CODE
009100     END-IF.
009200 2200-WRITE-POSTING.
009300     MOVE CORRESPONDING BANK-PAYMENT-RECORD TO POSTING-RECORD
009400     MOVE 'BANK' TO PO-SOURCE-SYSTEM
009500     WRITE POSTING-RECORD
009600     IF WS-POST-STATUS NOT = '00'
009700         DISPLAY 'TXNPAYB POSTOUT WRITE ERROR ' WS-POST-STATUS
009800         MOVE 16 TO RETURN-CODE
009900         PERFORM 9000-FINALIZE
010000         GOBACK
010100     END-IF
010200     ADD 1 TO WS-POST-COUNT.
010300 2300-WRITE-REJECT.
010400     MOVE BANK-PAYMENT-RECORD TO RJ-BANK-RECORD
010500     MOVE WS-ERROR-CODE TO RJ-REASON-CODE
010600     WRITE REJECT-RECORD
010700     ADD 1 TO WS-REJECT-COUNT.
010800 8100-READ-BANK.
010900     READ BANK-FILE
011000         AT END SET END-OF-BANK TO TRUE
011100         NOT AT END ADD 1 TO WS-READ-COUNT
011200     END-READ.
011300 9000-FINALIZE.
011400     CLOSE BANK-FILE POST-FILE REJECT-FILE
011500     DISPLAY 'TXNPAYB READ    ' WS-READ-COUNT
011600     DISPLAY 'TXNPAYB POSTED  ' WS-POST-COUNT
011700     DISPLAY 'TXNPAYB REJECTED' WS-REJECT-COUNT
011800     IF WS-READ-COUNT NOT = WS-POST-COUNT + WS-REJECT-COUNT
011900         DISPLAY 'TXNPAYB CONTROL TOTAL ERROR'
012000         MOVE 20 TO RETURN-CODE
012100     END-IF.
