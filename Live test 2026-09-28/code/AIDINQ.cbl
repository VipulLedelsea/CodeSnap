000100 IDENTIFICATION DIVISION.
000200 PROGRAM-ID. AIDINQ.
000300* CICS ONLINE INQUIRY - DISTRICT AID LOOKUP (TRANS AIDQ)
000400 DATA DIVISION.
000500 WORKING-STORAGE SECTION.
000600     EXEC SQL INCLUDE SQLCA END-EXEC.
000700 01  WS-DISTRICT-ID            PIC X(6).
000800 01  WS-TOTAL                  PIC 9(11)V99.
000900 01  WS-RESP                   PIC S9(8) COMP.
001000 01  WS-COMMAREA               PIC X(100).
001100 LINKAGE SECTION.
001200 01  DFHCOMMAREA               PIC X(100).
001300 PROCEDURE DIVISION.
001400 MAIN-PARA.
001500     IF EIBCALEN = 0
001600         MOVE SPACES TO WS-COMMAREA
001700     END-IF
001800     EXEC CICS RECEIVE MAP('AIDMAP1') MAPSET('AIDMAP')
001900         RESP(WS-RESP)
002000     END-EXEC
002100     IF WS-RESP NOT = DFHRESP(NORMAL)
002200         EXEC CICS XCTL PROGRAM('AIDERR') END-EXEC
002300     END-IF
002400     PERFORM LOOKUP-AID
002500     EXEC CICS LINK PROGRAM('AIDAUDIT')
002600         COMMAREA(WS-COMMAREA)
002700     END-EXEC
002800     EXEC CICS SEND MAP('AIDMAP1') MAPSET('AIDMAP') ERASE
002900     END-EXEC
003000     EXEC CICS RETURN TRANSID('AIDQ')
003100         COMMAREA(WS-COMMAREA)
003200     END-EXEC.
003300 LOOKUP-AID.
003400     EXEC SQL
003500         SELECT TOTAL_AMOUNT INTO :WS-TOTAL
003600         FROM MDE.DISTRICT_AID
003700         WHERE DISTRICT_ID = :WS-DISTRICT-ID
003800     END-EXEC
003900     IF SQLCODE NOT = 0
004000         EXEC CICS XCTL PROGRAM('AIDERR') END-EXEC
004100     END-IF.
