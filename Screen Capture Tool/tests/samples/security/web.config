<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="Students" connectionString="Server=MDESQL02;Database=Students;User ID=sa;Password=sa2005" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.5" />
    <customErrors mode="Off" />
    <trace enabled="true" />
    <pages validateRequest="false" />
    <authentication mode="Forms">
      <forms cookieless="UseUri" requireSSL="false">
        <credentials passwordFormat="Clear">
          <user name="admin" password="admin1" />
        </credentials>
      </forms>
    </authentication>
    <authorization>
      <allow users="*" />
    </authorization>
    <!-- <compilation debug="true" /> commented out -->
  </system.web>
  <system.serviceModel>
    <client>
      <endpoint address="http://mnit-esb01/StudentService.svc" binding="basicHttpBinding" contract="IStudentService" name="StudentSvc" />
    </client>
  </system.serviceModel>
</configuration>
