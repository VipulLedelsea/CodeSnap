* Annual aid distribution analysis.
GET FILE='/data/aid/district_aid_fy2019.sav'.
MATCH FILES /FILE=* /TABLE='/data/aid/district_lookup.sav' /BY DISTRICT_ID.
COMPUTE PER_PUPIL = TOTAL_AMOUNT / STUDENT_COUNT.
RECODE COUNTY (1 THRU 20=1) (ELSE=2) INTO REGION.
EXECUTE.
FREQUENCIES VARIABLES=REGION.
DESCRIPTIVES VARIABLES=PER_PUPIL /STATISTICS=MEAN STDDEV.
DEFINE !yr () '2019' !ENDDEFINE.
BEGIN PROGRAM PYTHON.
import spss
END PROGRAM.
SAVE OUTFILE='/data/aid/aid_summary.sav'.
SAVE TRANSLATE OUTFILE='/data/aid/aid_summary.xls' /TYPE=XLS.
