0010 DEFINE DATA
0020 PARAMETER
0030 1 #DIST (A6)
0040 LOCAL
0050 1 LEVY VIEW OF LEVY-CERT
0060   2 DISTRICT-ID
0070   2 AMOUNT
0080 END-DEFINE
0090 FIND LEVY WITH DISTRICT-ID = #DIST
0100   PERFORM CHECK-AMT
0110 END-FIND
0120 CALLNAT 'LEVYLOG' #DIST
0130 DEFINE SUBROUTINE CHECK-AMT
0140   IF AMOUNT < 0
0150     UPDATE
0160   END-IF
0170 END-SUBROUTINE
0180 END
